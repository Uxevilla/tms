# Copia a `.env` y ajusta. Sin `.env`, el stack usa los valores por defecto
# de docker-compose.yml (solo para desarrollo local).

POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_PORT=5432
REDIS_PORT=6379

# El worker también se puede ejecutar fuera de Docker apuntando a estos valores:
# PG_DSN=postgresql://tms:change-me-in-prod@localhost:5432/tms
# REDIS_URL=redis://localhost:6379/0
# STREAM_KEY=telemetria:ingesta
# CONSUMER_GROUP=workers
# DEAD_STREAM=telemetria:ingesta:dead
# BATCH_SIZE=500
# FLUSH_INTERVAL=2.0
# BLOCK_MS=5000
